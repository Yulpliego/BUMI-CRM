# Configuración local de Docker Compose.
# Usa una clave alfanumérica y larga para PostgreSQL.
POSTGRES_PASSWORD=cambia_esta_clave_local
# Usa una clave propia de 12 a 128 caracteres para el primer arranque.
DEMO_PASSWORD=cambia_esta_clave_de_demostracion
CRM_WEB_PORT=8080
CRM_ENVIRONMENT=Development
BUMI_DEMO_ENABLED=true

# Correo de recuperación opcional mediante un servidor SMTP con STARTTLS.
# RECOVERY_MAIL_ORIGIN=http://127.0.0.1:8080
# RECOVERY_MAIL_HOST=smtp.example.com
# RECOVERY_MAIL_PORT=587
# RECOVERY_MAIL_FROM=
# RECOVERY_MAIL_USERNAME=
# RECOVERY_MAIL_PASSWORD=
